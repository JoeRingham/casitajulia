# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# In production these are set in the Vercel project settings.
# ─────────────────────────────────────────────────────────────

# Long random string. Signs Payload's admin sessions.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Postgres connection string (Supabase → Project → Connect).
# Use the "Session pooler" URI; it works for both runtime and migrations.
DATABASE_URI=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# The shared password Julia gives to friends to get past the front gate.
SITE_PASSWORD=

# Signs the friends-gate cookie. Defaults to PAYLOAD_SECRET if unset.
# Set its own value so rotating one doesn't invalidate the other.
GATE_SECRET=

# Admin-panel login (username, not email). `npm run seed` creates this account,
# or resets its password to ADMIN_PASSWORD if it already exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Supabase Storage (S3-compatible) for villa photos & inline images ──
# Leave S3_BUCKET blank to store uploads on local disk instead (dev only).
# Supabase → Storage → S3 Connection.
S3_BUCKET=
S3_ENDPOINT=https://xxxx.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
